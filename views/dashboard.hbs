<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}}</title>
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <link rel="stylesheet" href="/admin.css" />
  </head>
  <body>
    <main class="container">
      <header class="header">
        <div>
          <h1>Work OS admin</h1>
          <p>Single-tenant control surface for Slack, Jira, GitHub, and AI routing.</p>
        </div>
        <form method="post" action="/admin/logout">
          <button type="submit" class="secondary">Sign out</button>
        </form>
      </header>

      {{#if message}}
        <p class="notice">{{message}}</p>
      {{/if}}

      <section class="grid summary">
        <article class="card">
          <h2>Health</h2>
          <p>Status: <strong>{{dashboard.health.status}}</strong></p>
          <p>Persistence: {{dashboard.health.modes.persistence}}</p>
          <p>AI: {{dashboard.health.modes.ai}}</p>
          <p>Selected provider: {{dashboard.health.modes.selectedProvider}}</p>
          <p>Action mode: {{dashboard.health.modes.actionExecution}}</p>
        </article>
        <article class="card">
          <h2>Integrations</h2>
          <p>Slack: {{#if dashboard.health.integrations.slack}}<strong class="good">configured</strong>{{else}}<strong class="bad">needs config</strong>{{/if}}</p>
          <p>Jira: {{#if dashboard.health.integrations.jira}}<strong class="good">configured</strong>{{else}}<strong class="bad">needs config</strong>{{/if}}</p>
          <p>GitHub: {{#if dashboard.health.integrations.github}}<strong class="good">configured</strong>{{else}}<strong class="bad">needs config</strong>{{/if}}</p>
        </article>
      </section>

      <section class="grid">
        <form method="post" action="/admin/settings/modes" class="card stack">
          <h2>Runtime modes</h2>
          <label>
            <span>Selected AI provider</span>
            <select name="selectedAiProvider">
              <option value="{{dashboard.aiSettings.selectedProvider}}">current: {{dashboard.aiSettings.selectedProvider}}</option>
              <option value="stub">stub</option>
              <option value="openai">openai</option>
              <option value="anthropic">anthropic</option>
            </select>
          </label>
          <label>
            <span>Action execution mode</span>
            <select name="actionExecutionMode">
              <option value="{{dashboard.actionExecutionMode}}">current: {{dashboard.actionExecutionMode}}</option>
              <option value="mock">mock</option>
              <option value="live">live</option>
            </select>
          </label>
          <button type="submit">Save runtime modes</button>
        </form>

        <form method="post" action="/admin/settings/ai" class="card stack">
          <h2>AI providers</h2>
          <p>AI mode from environment: <strong>{{dashboard.aiSettings.mode}}</strong></p>
          <label>
            <span>OpenAI model</span>
            <input name="openAiModel" value="{{dashboard.aiSettings.openAiModel}}" />
          </label>
          <label>
            <span>OpenAI API key</span>
            <input name="openAiApiKey" type="password" placeholder="{{#if dashboard.aiSettings.openAiApiKeyConfigured}}configured{{else}}not set{{/if}}" />
          </label>
          <label>
            <span>Anthropic model</span>
            <input name="anthropicModel" value="{{dashboard.aiSettings.anthropicModel}}" />
          </label>
          <label>
            <span>Anthropic API key</span>
            <input name="anthropicApiKey" type="password" placeholder="{{#if dashboard.aiSettings.anthropicApiKeyConfigured}}configured{{else}}not set{{/if}}" />
          </label>
          <button type="submit">Save AI settings</button>
        </form>

        <form method="post" action="/admin/settings/slack" class="card stack">
          <h2>Slack</h2>
          <p>Configured: {{#if dashboard.slackSettings.configured}}<strong class="good">configured</strong>{{else}}<strong class="bad">needs config</strong>{{/if}}</p>
          <label>
            <span>Bot token</span>
            <input name="botToken" type="password" placeholder="{{#if dashboard.slackSettings.botTokenConfigured}}configured{{else}}not set{{/if}}" />
          </label>
          <label>
            <span>Signing secret</span>
            <input name="signingSecret" type="password" placeholder="{{#if dashboard.slackSettings.signingSecretConfigured}}configured{{else}}not set{{/if}}" />
          </label>
          <button type="submit">Save Slack settings</button>
        </form>

        <form method="post" action="/admin/settings/jira" class="card stack">
          <h2>Jira</h2>
          <p>Configured: {{#if dashboard.jiraSettings.configured}}<strong class="good">configured</strong>{{else}}<strong class="bad">needs config</strong>{{/if}}</p>
          <label>
            <span>Base URL</span>
            <input name="baseUrl" value="{{dashboard.jiraSettings.baseUrl}}" />
          </label>
          <label>
            <span>Project key</span>
            <input name="projectKey" value="{{dashboard.jiraSettings.projectKey}}" />
          </label>
          <label>
            <span>User email</span>
            <input name="userEmail" value="{{dashboard.jiraSettings.userEmail}}" />
          </label>
          <label>
            <span>API token</span>
            <input name="apiToken" type="password" placeholder="{{#if dashboard.jiraSettings.apiTokenConfigured}}configured{{else}}not set{{/if}}" />
          </label>
          <button type="submit">Save Jira settings</button>
        </form>

        <form method="post" action="/admin/settings/github" class="card stack">
          <h2>GitHub</h2>
          <p>Configured: {{#if dashboard.githubSettings.configured}}<strong class="good">configured</strong>{{else}}<strong class="bad">needs config</strong>{{/if}}</p>
          <label>
            <span>Token</span>
            <input name="token" type="password" placeholder="{{#if dashboard.githubSettings.tokenConfigured}}configured{{else}}not set{{/if}}" />
          </label>
          <label>
            <span>Owner / org</span>
            <input name="owner" value="{{dashboard.githubSettings.owner}}" />
          </label>
          <label>
            <span>Default repository</span>
            <input name="defaultRepository" value="{{dashboard.githubSettings.defaultRepository}}" />
          </label>
          <label>
            <span>Default base branch</span>
            <input name="defaultBaseBranch" value="{{dashboard.githubSettings.defaultBaseBranch}}" />
          </label>
          <label>
            <input type="hidden" name="prCreationEnabled" value="false" />
            <input type="checkbox" name="prCreationEnabled" value="true" {{#if dashboard.githubSettings.prCreationEnabled}}checked{{/if}} />
            <span>Enable autonomous GitHub PR creation</span>
          </label>
          <label>
            <input type="hidden" name="defaultDraftPr" value="false" />
            <input type="checkbox" name="defaultDraftPr" value="true" {{#if dashboard.githubSettings.defaultDraftPr}}checked{{/if}} />
            <span>Default new PRs to draft</span>
          </label>
          <button type="submit">Save GitHub settings</button>
        </form>
      </section>

      <section class="grid">
        <article class="card">
          <div class="section-header">
            <h2>Recent inbound events</h2>
            <button class="secondary" hx-get="/admin/partials/events" hx-target="#events-partial" hx-swap="innerHTML">Refresh</button>
          </div>
          <div id="events-partial" hx-get="/admin/partials/events" hx-trigger="load, every 10s" hx-swap="innerHTML">
            {{> events events=dashboard.recentEvents}}
          </div>
        </article>

        <article class="card">
          <div class="section-header">
            <h2>Recent workflow runs</h2>
            <button class="secondary" hx-get="/admin/partials/runs" hx-target="#runs-partial" hx-swap="innerHTML">Refresh</button>
          </div>
          <div id="runs-partial" hx-get="/admin/partials/runs" hx-trigger="load, every 10s" hx-swap="innerHTML">
            {{> runs runs=dashboard.recentRuns}}
          </div>
        </article>
      </section>
    </main>
  </body>
</html>
