NODE_ENV=development
PORT=3000

# Postgres defaults for local development.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=work_os

# Optional: use this instead of the POSTGRES_* fields above.
# DATABASE_URL=postgres://USERNAME:PASSWORD@127.0.0.1:5432/work_os

ADMIN_TOKEN=token

AI_MODE=stub
DEFAULT_AI_PROVIDER=stub
ACTION_EXECUTION_MODE=mock

# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

SLACK_SKIP_SIGNATURE_VERIFICATION=false
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

JIRA_BASE_URL=
JIRA_PROJECT_KEY=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=

# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_DEFAULT_REPOSITORY=
GITHUB_DEFAULT_BASE_BRANCH=main
GITHUB_PR_CREATION_ENABLED=false
GITHUB_DEFAULT_DRAFT_PR=true
GITHUB_EXECUTION_RUNNER=copilot

CLAUDE_REMOTE_ENABLED=false
CLAUDE_COMMAND=claude
CLAUDE_WORKING_DIRECTORY=/tmp/work-os-claude